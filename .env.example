# Base URL of the FastAPI backend, including its /api prefix.
#
# Use 127.0.0.1 rather than localhost: Node resolves localhost to ::1 first, and
# a uvicorn bound to IPv4 refuses that connection on Windows.
#
# This is a server-only variable (no NEXT_PUBLIC_ prefix) — it is never sent to
# the browser. Client components reach the API through the same-origin proxy at
# /api/[...path], which is what lets the app work against a backend that mounts
# no CORS middleware.
API_BASE_URL=http://127.0.0.1:8000/api

# Abort an upstream request after this many milliseconds.
API_TIMEOUT_MS=15000
